# data2intelligence — environment variables (local runs)
# Copy to .env and fill in:   cp .env.example .env
# Never commit .env — it is in .gitignore.

# Groq — used for both LLM calls (the chatbot's answer and the gateway's claim extraction)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: a different model for the chatbot itself
# GROQ_BOT_MODEL=llama-3.3-70b-versatile
